{
  "name": "nomad-path",
  "private": true,
  "version": "0.1.0",
  "description": "Visualise GPS trip recordings on interactive basemaps: deploy-time pipeline + browser UI library",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/contract && tsc -p packages/preprocess && tsc -p packages/ui && tsc -p packages/demo && tsc -p packages/e2e && tsc -p .",
    "lint:code": "eslint .",
    "lint:docs": "markdownlint-cli2",
    "lint:links": "linkinator docs README.md CLAUDE.md --markdown --skip \"^https?://\"",
    "lint": "npm run lint:code && npm run lint:docs && npm run lint:links",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e --workspace @nomadpath/e2e",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "linkinator": "^7.6.1",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml,html,css}": "prettier --write"
  }
}
