{
  "name": "nomad-path",
  "version": "0.2.0",
  "description": "A TypeScript library for visualising GPS travel data on interactive web maps",
  "type": "module",
  "main": "dist/nomad-path.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/nomad-path.js",
    "dist/nomad-path.js.map",
    "dist/nomad-path.css",
    "dist/contract.js",
    "dist/contract.js.map",
    "dist/types"
  ],
  "scripts": {
    "_copy:demo": "node -e \"const fs=require('fs');fs.mkdirSync('harness/demo/dist',{recursive:true});['nomad-path.profiling.js','nomad-path.css'].forEach(f=>fs.cpSync('dist/'+f,'harness/demo/dist/'+f));\"",
    "_copy:library": "node -e \"const fs=require('fs');fs.mkdirSync('test/integration/dist',{recursive:true});['nomad-path.js','nomad-path.css'].forEach(f=>fs.cpSync('dist/'+f,'test/integration/dist/'+f));\"",
    "_copy:e2e": "node -e \"const fs=require('fs');fs.mkdirSync('test/e2e/dist',{recursive:true});['nomad-path.js','nomad-path.css'].forEach(f=>fs.cpSync('dist/'+f,'test/e2e/dist/'+f));\"",
    "_copy:perf": "node -e \"const fs=require('fs');fs.mkdirSync('harness/perf/dist',{recursive:true});['nomad-path.profiling.js','nomad-path.css'].forEach(f=>fs.cpSync('dist/'+f,'harness/perf/dist/'+f));\"",
    "_build:library": "npm run build:lib && npm run _copy:library",
    "_build:e2e": "npm run build:lib && npm run _copy:e2e && npm run _build:fixture",
    "_build:perf": "npm run build:lib && npm run _copy:perf && npm run _build:perf:fixture",
    "_build:fixture": "node -e \"const fs=require('fs'),d='test/fixtures/map';if(fs.existsSync(d)&&fs.readdirSync(d).length){const{execSync}=require('child_process');execSync('node preprocessing/build-trip-data.js -i test/fixtures/map -o test/e2e/fixture.geojson -n \\\"Meridian Trip\\\"',{stdio:'inherit'})}\"",
    "_build:perf:fixture": "node -e \"const fs=require('fs'),d='test/fixtures/map';if(fs.existsSync(d)&&fs.readdirSync(d).length){const{execSync}=require('child_process');execSync('node preprocessing/build-trip-data.js -i test/fixtures/map -o harness/perf/fixture.geojson -n \\\"Meridian Trip\\\"',{stdio:'inherit'})}\"",
    "build:lib": "rollup -c && node -e \"require('fs').cpSync('src/ui/nomad-path.css','dist/nomad-path.css')\"",
    "build:contract": "rollup -c rollup.contract.config.js",
    "build:data": "npm run build:contract && node preprocessing/build-trip-data.js",
    "build:demo": "npm run build:lib && npm run _copy:demo",
    "demo": "npm run build:demo && npx serve ./harness/demo",
    "watch": "npm run build:demo && node preprocessing/watch.js",
    "git:enable": "node preprocessing/enable-git-rebuilds.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write 'src/**/*.{ts,css}'",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "npm run test:unit -- --coverage",
    "test:unit:watch": "vitest",
    "test:library": "npm run _build:library && playwright test --project=chromium",
    "test:e2e": "npm run _build:e2e && playwright test -c playwright.e2e.config.ts --project=chromium",
    "test:all": "npm run test:unit && npm run test:library && npm run test:e2e",
    "test:perf": "npm run _build:perf && playwright test -c playwright.perf.config.ts --project=chromium",
    "test:all:browsers": "npm run test:unit && npm run _build:library && playwright test && npm run _build:e2e && playwright test -c playwright.e2e.config.ts",
    "test:library:debug": "npm run _build:library && playwright test --ui",
    "test:e2e:debug": "npm run _build:e2e && playwright test -c playwright.e2e.config.ts --ui",
    "test:library:install": "playwright install chromium",
    "clean": "node -e \"['dist','harness/demo/dist','harness/perf/dist','test/integration/dist','test/e2e/dist','coverage','playwright-report','test-results'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@turf/bbox": "^7.0.0",
    "@turf/helpers": "^7.3.4",
    "@turf/length": "^7.0.0",
    "maplibre-gl": "^4.0.0",
    "untildify": "^6.0.0"
  },
  "devDependencies": {
    "@mapbox/geojsonhint": "^3.3.0",
    "@photostructure/tz-lookup": "^8.0.0",
    "@playwright/test": "^1.40.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@tmcw/togeojson": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@xmldom/xmldom": "^0.8.11",
    "chokidar": "^3.6.0",
    "eslint": "^8.55.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "luxon": "^3.4.0",
    "prettier": "^3.1.0",
    "rollup": "^4.0.0",
    "serve": "^14.2.0",
    "simplify-js": "^1.2.4",
    "suncalc": "^1.9.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
