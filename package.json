{
  "name": "leaflet-map",
  "version": "0.3.0",
  "description": "Simple library for creating a Leaflet map",
  "author": "dpet23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpet23/leaflet-map.git"
  },
  "keywords": [
    "leaflet",
    "leaflet-map",
    "maps"
  ],
  "main": "map-leaflet.ts",
  "scripts": {
    "lint:ts": "eslint src --ext .ts",
    "lint:css": "stylelint src/**/*.?(s)css",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:css -- --fix",
    "lint:rollup": "eslint rollup.config.mjs --fix",
    "build:ts": "tsc",
    "build:css": "sass --verbose --no-source-map --update src:./build/main.css",
    "build": "npm run build:ts && npm run build:css",
    "dist:expand": "rollup --config rollup.config.mjs",
    "dist:minify": "rollup --config rollup.config.mjs --minify",
    "dist": "npm run dist:expand && npm run dist:minify"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/geojson": "^7946.0.11",
    "@types/leaflet": "^1.9.6",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.51.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsdoc": "^46.8.2",
    "eslint-plugin-prefer-arrow-functions": "^3.2.4",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sonarjs": "^0.21.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "leaflet": "^1.9.4",
    "ngxleafletmultioptionspolyline": "^1.0.0",
    "prettier": "^3.0.3",
    "rollup": "^4.1.0",
    "rollup-plugin-scss": "^4.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "sass": "^1.69.5",
    "stylelint": "^15.11.0",
    "stylelint-config-sass-guidelines": "^10.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.0.2",
    "typescript": "^5.2.2"
  }
}
