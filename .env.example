# Copy this file to .env.local (gitignored) and fill in your key.
# See README.md for how to create the key and cap usage to stay free.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: tile quality/cost tradeoff. Higher = fewer tile requests = cheaper
# but blurrier. deck.gl's example uses 16-20; try 40+ for cheap exploration.
VITE_MAX_SCREEN_SPACE_ERROR=16
