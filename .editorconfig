# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Common settings for every file
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
indent_size = 2
max_line_length = off

[*.{yml,yaml,json,jsonc}]
indent_size = 2
